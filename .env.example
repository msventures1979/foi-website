# Öffentliche Adresse der Seite (Links in Mails, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://frontlineofinnovation.de
# bis zum Umzug der Domain auf 1 lassen – dann wird nichts indexiert
NEXT_PUBLIC_NOINDEX=1

# Supabase – Projekt „foi-website“ in der Organisation FOI (Settings › API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# geheim – nur in Vercel bzw. .env.local, nie ins Repo
SUPABASE_SERVICE_ROLE_KEY=

# Resend – Domain frontlineofinnovation.de ist verifiziert (geheim)
RESEND_API_KEY=
MAIL_FROM="Frontline of Innovation <info@frontlineofinnovation.de>"
# Empfänger der Benachrichtigungen über neue Anfragen (Komma-getrennt)
NOTIFY_TO=info@frontlineofinnovation.de
